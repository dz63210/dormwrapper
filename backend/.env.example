# Backend environment variables

# SQLite database file path (relative to the backend/ dir)
DATABASE_URL=./data/app.db

# Where uploaded student photos are stored
UPLOAD_DIR=./data/uploads

# CORS: comma-separated list of allowed frontend origins
FRONTEND_ORIGINS=http://localhost:5173

# Explicit opt-in to accepting arbitrary localhost ports; keep false publicly.
DEVELOPMENT_CORS=false
# Guest tokens expire after 24 hours. Changing this affects new sessions.
SESSION_HOURS=24
MAX_UPLOAD_BYTES=8388608
MAX_IMAGE_PIXELS=20000000
LOGIN_ATTEMPTS_PER_HOUR=20
UPLOADS_PER_HOUR=30
GENERATIONS_PER_HOUR=10
# Full AI prompts can contain user notes. Keep disabled for public use.
DEBUG_AI_LOGGING=false

# Verified email sign-in through Supabase Auth (Email OTP).
# Use the project origin and publishable key, never a service-role key.
SUPABASE_URL=
SUPABASE_PUBLISHABLE_KEY=
VERIFIED_SESSION_HOURS=168
EMAIL_REQUESTS_PER_HOUR=3
EMAIL_VERIFICATIONS_PER_HOUR=10
# Legacy guest creation is disabled by default. Existing guest sessions can
# verify an email to retain their designs. Enable only for offline development.
ALLOW_GUEST_LOGIN=false

# IKEA catalogue JSON the DB is seeded from (generated by `python export_catalog.py`)
CATALOGUE_DATA_FILE=./data/catalog.json
# Folder of product photos served at /catalogue-images (repo-root images/)
CATALOGUE_IMAGES_DIR=../images

# "Generate design" runs two AI stages, each with its own provider switch.
#   mock   - deterministic, no API key needed
#   gemini - Google Gemini; set GEMINI_API_KEY
# Stage 1: text inputs -> structured furniture recommendation (gemini-2.5-flash)
RECOMMENDATION_PROVIDER=mock
# Stage 2: recommendation -> room image ("Nano Banana 2 Lite", gemini-3.1-flash-lite-image)
IMAGE_GEN_PROVIDER=mock

# Instruction documents for each stage (paths relative to the backend/ dir).
# A missing file is tolerated - that stage just runs with no extra instructions.
RECOMMENDATION_PROMPT_PATH=./app/prompts/recommendation.md
IMAGE_GEN_CONTEXT_PATH=./app/prompts/image_gen_context.md

# Get a key at https://aistudio.google.com/apikey
GEMINI_API_KEY=

# Unused stub:
# REPLICATE_API_TOKEN=
